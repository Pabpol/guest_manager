# Database Configuration
# For development, leave DB_DIALECT empty or set to 'sqlite' for in-memory database
# For production, set to 'mysql' and configure the MySQL connection details below

# Database type: 'mysql' for production, 'sqlite' for development (in-memory)
DB_DIALECT=sqlite

# MySQL Database Configuration (for production)
DB_USER=root
DB_PASS=admin
DB_NAME=guest_manager
DB_HOST=127.0.0.1
DB_PORT=3306

# Server Configuration
PORT=3000
NODE_ENV=development